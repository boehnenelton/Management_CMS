@cli.group()
def seo():
    """SEO metadata management."""


@seo.command("set")
@click.argument("page_id")
@click.option("--meta-title", default=None)
@click.option("--meta-keywords", default=None)
@click.option("--og-title", default=None)
@click.option("--og-description", default=None)
@click.option("--canonical-url", default=None)
@click.pass_context
def seo_set(ctx, page_id, meta_title, meta_keywords, og_title, og_description, canonical_url):
    project = _get_project(ctx); _check_exists(project)
    fields = {k: v for k, v in {
        "meta_title": meta_title, "meta_keywords": meta_keywords, "og_title": og_title,
        "og_description": og_description, "canonical_url": canonical_url,
    }.items() if v is not None}
    project.seo_set(page_id, **fields)
    click.echo("SEO updated")


